[Unit]
Description=Home Assistant Door Signboard
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=door-signboard
Group=door-signboard
SupplementaryGroups=gpio spi
WorkingDirectory=/opt/door-signboard
Environment=PYTHONPATH=/opt/door-signboard/src
ExecStart=/opt/door-signboard/.venv/bin/python -m door_signboard.main --output-mode hardware
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
